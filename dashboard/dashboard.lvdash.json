{
  "datasets": [
    {
      "name": "67c6fda5",
      "displayName": "kpi_concesionarios",
      "config": {
        "version": "1.1",
        "source": "vehiculos.golden.kpi_concesionarios",
        "dimensions": [
          {
            "expr": "dealer_name",
            "displayName": "Concesionario"
          },
          {
            "expr": "modelo_top",
            "displayName": "Modelo top"
          },
          {
            "expr": "unidades",
            "displayName": "Unidades"
          },
          {
            "expr": "monto_total",
            "displayName": "Monto total",
            "format": {
              "type": "currency",
              "currencyCode": "USD"
            }
          },
          {
            "expr": "ticket_promedio",
            "displayName": "Ticket promedio",
            "format": {
              "type": "currency",
              "currencyCode": "USD"
            }
          },
          {
            "expr": "participacion_pct",
            "displayName": "Participación (%)"
          }
        ],
        "measures": [
          {
            "name": "total_unidades",
            "expr": "SUM(unidades)",
            "displayName": "Unidades vendidas"
          },
          {
            "name": "total_monto",
            "expr": "SUM(monto_total)",
            "displayName": "Monto total vendido",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "abbreviation": "compact"
            }
          },
          {
            "name": "ticket_prom",
            "expr": "SUM(monto_total) / SUM(unidades)",
            "displayName": "Ticket promedio",
            "format": {
              "type": "currency",
              "currencyCode": "USD"
            }
          },
          {
            "name": "concesionarios",
            "expr": "COUNT(DISTINCT dealer_name)",
            "displayName": "Concesionarios"
          }
        ]
      }
    },
    {
      "name": "74e95919",
      "displayName": "ranking_modelos",
      "config": {
        "source": "vehiculos.golden.ranking_modelos",
        "measures": [
          {
            "name": "total_monto",
            "expr": "SUM(monto_total)",
            "displayName": "Monto total",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "abbreviation": "compact"
            }
          },
          {
            "name": "total_unidades",
            "expr": "SUM(unidades)",
            "displayName": "Unidades"
          }
        ],
        "filter": "ranking_anual <= 10",
        "version": "1.1",
        "dimensions": [
          {
            "expr": "sale_year",
            "displayName": "Año"
          },
          {
            "expr": "company",
            "displayName": "Marca"
          },
          {
            "expr": "model",
            "displayName": "Modelo"
          },
          {
            "name": "modelo",
            "expr": "CONCAT(company, ' ', model)",
            "displayName": "Marca y modelo"
          },
          {
            "expr": "ranking_anual",
            "displayName": "Ranking anual"
          }
        ]
      }
    },
    {
      "name": "bd780819",
      "displayName": "segmentos_clientes",
      "config": {
        "version": "1.1",
        "source": "vehiculos.golden.segmentos_clientes",
        "dimensions": [
          {
            "expr": "income_segment",
            "displayName": "Segmento de ingreso"
          },
          {
            "name": "orden_segmento",
            "expr": "CASE income_segment WHEN 'Bajo' THEN 1 WHEN 'Medio' THEN 2 WHEN 'Alto' THEN 3 WHEN 'Premium' THEN 4 ELSE 5 END"
          },
          {
            "expr": "gender",
            "displayName": "Género"
          },
          {
            "expr": "body_style",
            "displayName": "Carrocería"
          }
        ],
        "measures": [
          {
            "name": "total_unidades",
            "expr": "SUM(unidades)",
            "displayName": "Unidades"
          },
          {
            "name": "total_monto",
            "expr": "SUM(monto_total)",
            "displayName": "Monto total",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "abbreviation": "compact"
            }
          },
          {
            "name": "ticket_prom",
            "expr": "SUM(monto_total) / SUM(unidades)",
            "displayName": "Ticket promedio",
            "format": {
              "type": "currency",
              "currencyCode": "USD"
            }
          }
        ]
      }
    },
    {
      "name": "fd30d843",
      "displayName": "ventas_mensuales_estado",
      "config": {
        "version": "1.1",
        "source": "vehiculos.golden.ventas_mensuales_estado",
        "dimensions": [
          {
            "expr": "source.*"
          },
          {
            "name": "fecha",
            "expr": "MAKE_DATE(sale_year, sale_month, 1)",
            "displayName": "Mes"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "name": "total_monto",
            "expr": "SUM(monto_total)",
            "displayName": "Monto vendido",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "abbreviation": "compact"
            }
          },
          {
            "name": "variacion_prom",
            "expr": "AVG(variacion_mom_pct)",
            "displayName": "Variación mensual promedio (%)"
          }
        ]
      }
    }
  ],
